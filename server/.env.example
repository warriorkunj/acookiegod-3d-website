# ------------------------------------------------------------------
# COPY THIS FILE TO .env AND FILL IN REAL VALUES — NEVER COMMIT .env
# ------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# MongoDB connection string — cloud Atlas URI, no local MongoDB required.
# Create a free cluster at https://cloud.mongodb.com and paste the real
# "mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/..." URI here.
MONGO_URI="mongodb+srv://publicUser:cookieGod2026@cluster0.abcde.mongodb.net/cookie_db?retryWrites=true&w=majority"

# JWT session encryption secret. Use a LONG random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# How long issued tokens stay valid (see jsonwebtoken expiry syntax)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed front-end origins (no trailing slash).
# Leave empty to allow the served static site + any origin in development.
CLIENT_ORIGIN=http://127.0.0.1:8080

# Optional: if set, Express also statically serves the front-end HTML (relative
# to server/). Keeps the currency fetch same-origin. Example: ../
STATIC_DIR=../

# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stripe payment gateway secret key (sk_test_... or sk_live_...).
# Get test keys at https://dashboard.stripe.com/test/apikeys.
# Leave empty => the secure checkout falls back to the demo simulation route.
PAYMENT_PUBLISHABLE_KEY=
PAYMENT_SECRET_KEY=
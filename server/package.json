{
  "name": "acookiegod-api",
  "version": "1.0.0",
  "description": "Production REST API for the ACookieGod 3D e-commerce store. Auth (bcryptjs + JWT), live server-side currency conversion for products, and a verified mock checkout pipeline ready to attach Stripe/Razorpay.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seedProducts.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ecommerce",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "rest-api"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
